{
  "name": "dagsk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dagsk-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dagsk-db --remote",
    "db:migrate:milo:local": "wrangler d1 migrations apply dagsk-milo-db --local",
    "db:migrate:milo:remote": "wrangler d1 migrations apply dagsk-milo-db --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2"
  }
}
